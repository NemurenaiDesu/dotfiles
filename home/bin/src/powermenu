#!/usr/bin/env sh

options="Shutdown\nSuspend\nReboot\nReload\nLogout"

choice=$(echo -e "$options" | fzf --ansi --highlight-line --margin=0%)

case $choice in
    "Shutdown")
        systemctl poweroff
    ;;
    "Suspend")
        systemctl suspend
    ;;
    "Reboot")
        systemctl reboot
	;;
    "Reload")
        systemctl soft-reboot
    ;;
    "Logout")
        uwsm stop || loginctl terminate-session
    ;;
    *)
        exit
    ;;
esac
